# 이 파일을 config/settings.local.yaml 로 복사해서 쓰세요(복사본은 git에 올라가지 않습니다).
# 아래 두 값은 settings.local.yaml 에서만 인식됩니다. config/settings.yaml 의 같은 값은 무시됩니다.
#
# 처음에는 아무것도 바꾸지 마세요(기본값 = 실제 수정 꺼짐). 모든 명령이 모의 실행으로만 동작합니다.
# 12단계(실제 반영 테스트)에서 비공개 테스트 영상 1개로만 켭니다.
live:
  enable_live: false          # true로 바꾸면 apply --live 가 가능해집니다(승인 파일·영상 ID 입력 등 14단계 조건도 모두 필요).
  live_allowlist: []          # 실제 수정을 허용할 영상 ID. 예: ["abc123DEF45"]. 비어 있으면 모든 영상을 거부합니다.
